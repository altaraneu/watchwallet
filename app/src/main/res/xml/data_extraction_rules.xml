<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: never upload app data to cloud backup (it would reveal all tracked addresses
    to the backup provider). Direct device-to-device transfer when switching phones is allowed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
